@page
@model SitiosPersonal.Pages.Empleados.IndexModel
@{
    ViewData["Title"] = "Empleados";
}

<div class="crud-card card">
    <div class="crud-card-header d-flex justify-content-between align-items-center">
        <h4 class="crud-card-title"><i class="fas fa-users"></i> Empleados Contratados</h4>
        <a asp-page="Contratar" class="btn btn-primary btn-sm"><i class="fas fa-user-plus"></i> Contratar</a>
    </div>

    <div class="card-body">
        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success">@TempData["Exito"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>No. Empleado</th>
                        <th>Nombre</th>
                        <th>Identificación</th>
                        <th>Puesto</th>
                        <th>Fecha Contratación</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ViewModel.Empleados.Any())
                    {
                        foreach (var emp in Model.ViewModel.Empleados)
                        {
                            <tr>
                                <td>@emp.numero_empleado</td>
                                <td>@emp.nombre_completo</td>
                                <td>@emp.identificacion</td>
                                <td>@emp.NombrePuesto</td>
                                <td>@emp.fecha_contratacion.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (emp.estado == "ACTIVO")
                                    {
                                        <span class="badge bg-success">ACTIVO</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@emp.estado</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">No se encontraron empleados contratados.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.ViewModel.TotalPaginas > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int numeroPagina = 1; numeroPagina <= Model.ViewModel.TotalPaginas; numeroPagina++)
                    {
                        <li class="page-item @(numeroPagina == Model.ViewModel.Pagina ? "active" : "")">
                            <a class="page-link" asp-page="Index" asp-route-pagina="@numeroPagina">@numeroPagina</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>