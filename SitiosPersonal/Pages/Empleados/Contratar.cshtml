@page
@model SitiosPersonal.Pages.Empleados.ContratarModel
@{
    ViewData["Title"] = "Contratar Empleado";
}

<form method="post">
    <div class="form-action-panel">
        <a asp-page="Index" class="action-circle" title="Regresar">
            <i class="fas fa-arrow-left"></i>
        </a>

        <button type="submit" class="action-circle" title="Contratar">
            <i class="fas fa-save"></i>
        </button>
    </div>

    <div class="form-card card">
        <div class="crud-card-header">
            <h4 class="crud-card-title">Formulario de Contratación</h4>
        </div>

        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.id_oferente" class="form-label">Oferente *</label>
                    <select asp-for="Input.id_oferente" class="form-select"
                            asp-items="@(new SelectList(Model.OferentesDisponibles, "id_oferente", "nombre_completo"))">
                        <option value="">-- Seleccione un oferente --</option>
                    </select>
                    <span asp-validation-for="Input.id_oferente" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.id_puesto" class="form-label">Puesto *</label>
                    <select asp-for="Input.id_puesto" class="form-select"
                            asp-items="@(new SelectList(Model.PuestosDisponibles, "id_puesto", "nombre"))">
                        <option value="">-- Seleccione un puesto --</option>
                    </select>
                    <span asp-validation-for="Input.id_puesto" class="text-danger small"></span>
                </div>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mt-3">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}