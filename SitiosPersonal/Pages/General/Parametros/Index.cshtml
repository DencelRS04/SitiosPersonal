@page "/General/Parametros"
@model SitiosPersonal.Pages.General.Parametros.IndexModel

@{
    ViewData["Title"] = "Parámetros";
}

<div class="crud-card card">

    <div class="crud-card-header d-flex justify-content-between align-items-center">
        <h4 class="crud-card-title">
            <i class="fas fa-sliders-h"></i>
            Mantenimiento de Parámetros
        </h4>
        <a asp-page="Crear" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i>
            Nuevo
        </a>
    </div>

    <div class="card-body">

        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Valor</th>
                        <th style="width:140px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Lista.Parametros.Any())
                    {
                        foreach (var item in Model.Lista.Parametros)
                        {
                            <tr>
                                <td>@item.codigo</td>
                                <td>@item.valor</td>
                                <td>
                                    <a asp-page="Editar" asp-route-id="@item.id_parametro"
                                       class="btn btn-primary btn-sm btn-icon">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-danger btn-sm btn-icon"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar"
                                            data-id="@item.id_parametro"
                                            data-nombre="@item.codigo">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="3" class="text-center text-muted">No se encontraron registros.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Lista.TotalPaginas > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int p = 1; p <= Model.Lista.TotalPaginas; p++)
                    {
                        <li class="page-item @(p == Model.Lista.Pagina ? "active" : "")">
                            <a class="page-link" asp-page="Index" asp-route-pagina="@p">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }

    </div>
</div>

<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Realmente desea eliminar el elemento seleccionado?<br />
                <strong id="nombreEliminar"></strong>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <form id="formEliminar" method="post">
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="modalMensaje" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="modalMensajeHeader">
                <h5 class="modal-title" id="modalMensajeTitulo"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalMensajeTexto"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.getElementById('modalEliminar').addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('nombreEliminar').textContent = btn.getAttribute('data-nombre');
            document.getElementById('formEliminar').action = '/General/Parametros?handler=Eliminar&id=' + btn.getAttribute('data-id');
        });
    </script>
    <script>
        (function () {
            var exito = '@Html.Raw(TempData["Exito"])';
            var error = '@Html.Raw(TempData["Error"])';
            var msg = exito || error;
            if (msg) {
                var header = document.getElementById('modalMensajeHeader');
                header.className = 'modal-header ' + (exito ? 'bg-success text-white' : 'bg-danger text-white');
                document.getElementById('modalMensajeTitulo').textContent = exito ? 'Operación exitosa' : 'Error';
                document.getElementById('modalMensajeTexto').textContent = msg;
                var modal = new bootstrap.Modal(document.getElementById('modalMensaje'));
                modal.show();
            }
        })();
    </script>
}
