@page "/General/Parametros/Crear"
@model SitiosPersonal.Pages.General.Parametros.CrearModel

@{
    ViewData["Title"] = "Formulario Parámetro";
}

<form method="post">

    <div class="form-action-panel">
        <a asp-page="Index" class="action-circle" title="Regresar">
            <i class="fas fa-arrow-left"></i>
        </a>
        <button type="submit" class="action-circle" title="Guardar">
            <i class="fas fa-save"></i>
        </button>
    </div>

    <div class="form-card card">
        <div class="crud-card-header">
            <h4 class="crud-card-title">Formulario Parámetro</h4>
        </div>
        <div class="card-body">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label class="form-label">Código del parámetro</label>
                <input asp-for="Parametro.codigo" class="form-control" maxlength="100" />
                <span asp-validation-for="Parametro.codigo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Valor</label>
                <textarea asp-for="Parametro.valor" class="form-control" maxlength="500" rows="3"></textarea>
                <span asp-validation-for="Parametro.valor" class="text-danger"></span>
            </div>
        </div>
    </div>

</form>


<div class="modal fade" id="modalMensaje" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" id="modalMensajeHeader">
                <h5 class="modal-title" id="modalMensajeTitulo"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalMensajeTexto"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var exito = '@Html.Raw(TempData["Exito"])';
            var error = '@Html.Raw(TempData["Error"])';
            var msg = exito || error;
            if (msg) {
                var header = document.getElementById('modalMensajeHeader');
                header.className = 'modal-header ' + (exito ? 'bg-success text-white' : 'bg-danger text-white');
                document.getElementById('modalMensajeTitulo').textContent = exito ? 'Operación exitosa' : 'Error';
                document.getElementById('modalMensajeTexto').textContent = msg;
                var modal = new bootstrap.Modal(document.getElementById('modalMensaje'));
                modal.show();
            }
        })();
    </script>
}
