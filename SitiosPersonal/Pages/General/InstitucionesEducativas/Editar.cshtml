@page "/General/Instituciones/Editar/{id:int}"
@model SitiosPersonal.Pages.General.InstitucionesEducativas.EditarModel

@{
    ViewData["Title"] = "Formulario Institución Educativa";
}

<form method="post">

    <div class="form-action-panel">
        <a asp-page="Index" class="action-circle" title="Regresar">
            <i class="fas fa-arrow-left"></i>
        </a>
        <button type="submit" class="action-circle" title="Guardar">
            <i class="fas fa-save"></i>
        </button>
    </div>

    <div class="form-card card">
        <div class="crud-card-header">
            <h4 class="crud-card-title">Formulario Institución Educativa</h4>
        </div>
        <div class="card-body">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Institucion.id_institucion" />
            <div class="mb-3">
                <label class="form-label">Código</label>
                <input asp-for="Institucion.codigo" class="form-control" maxlength="50" />
                <span asp-validation-for="Institucion.codigo" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Nombre</label>
                <input asp-for="Institucion.nombre" class="form-control" maxlength="150" />
                <span asp-validation-for="Institucion.nombre" class="text-danger"></span>
            </div>
        </div>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
