@page "/General/Bitacora"
@model SitiosPersonal.Pages.General.Bitacora.IndexModel
@{
    ViewData["Title"] = "Bitácora";
    int totalPaginas = (int)Math.Ceiling((double)Model.Filtro.TotalRegistros / Model.Filtro.CantidadPorPagina);
}

<div class="mb-4">
    <h4 class="fw-bold" style="color:#0b2f6b;">
        <i class="fas fa-history me-2"></i> Bitácora del Sistema
    </h4>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">

        <form method="get" class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label fw-semibold">Usuario</label>
                <input type="text"
                       name="usuarioFiltro"
                       value="@Model.Filtro.UsuarioFiltro"
                       class="form-control"
                       placeholder="Buscar usuario" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-semibold">Descripción</label>
                <input type="text"
                       name="descripcionFiltro"
                       value="@Model.Filtro.DescripcionFiltro"
                       class="form-control"
                       placeholder="Buscar descripción" />
            </div>

            <div class="col-md-2">
                <label class="form-label fw-semibold">Orden</label>
                <select name="orden" class="form-select">
                    <option value="fecha_desc" selected="@(Model.Filtro.Orden == "fecha_desc")">
                        Fecha descendente
                    </option>
                    <option value="fecha_asc" selected="@(Model.Filtro.Orden == "fecha_asc")">
                        Fecha ascendente
                    </option>
                    <option value="usuario_asc" selected="@(Model.Filtro.Orden == "usuario_asc")">
                        Usuario A-Z
                    </option>
                    <option value="usuario_desc" selected="@(Model.Filtro.Orden == "usuario_desc")">
                        Usuario Z-A
                    </option>
                </select>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="fas fa-search me-1"></i> Buscar
                </button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 170px;">Fecha</th>
                        <th style="width: 200px;">Usuario</th>
                        <th>Descripción de la acción</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Filtro.Bitacoras.Any())
                    {
                        foreach (var item in Model.Filtro.Bitacoras)
                        {
                            <tr>
                                <td>
                                    @item.fecha.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @item.usuario
                                </td>

                                <td style="white-space: pre-wrap; overflow-wrap:anywhere;">
                                    @if (!string.IsNullOrWhiteSpace(item.descripcion))
                                    {
                                        @item.descripcion
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin descripción</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                No se encontraron registros.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPaginas > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center mb-0">
                    @for (int numeroPagina = 1; numeroPagina <= totalPaginas; numeroPagina++)
                    {
                        <li class="page-item @(numeroPagina == Model.Filtro.Pagina ? "active" : "")">
                            <a class="page-link"
                                   asp-page="Index"
                                   asp-route-pagina="@numeroPagina"
                                   asp-route-usuarioFiltro="@Model.Filtro.UsuarioFiltro"
                                   asp-route-descripcionFiltro="@Model.Filtro.DescripcionFiltro"
                                   asp-route-orden="@Model.Filtro.Orden">
                                @numeroPagina
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>