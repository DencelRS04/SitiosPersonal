@page "/Oferentes"
@model SitiosPersonal.Pages.Oferentes.IndexModel

@{
    ViewData["Title"] = "Oferentes";
}

<div class="crud-card card">

    <div class="crud-card-header d-flex justify-content-between align-items-center">

        <h4 class="crud-card-title">
            <i class=></i>
            Mantenimiento de Oferentes
        </h4>

        <a asp-page="Crear" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i>
            Nuevo
        </a>

    </div>

    <div class="card-body">

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success">
                @TempData["Exito"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead>
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th>Identificación</th>
                        <th>Tipo</th>
                        <th>Nombre completo</th>
                        <th>Fecha nacimiento</th>
                        <th style="width:165px;">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Lista.Oferentes.Any())
                    {
                        foreach (var item in Model.Lista.Oferentes)
                        {
                            <tr>
                                <td>@item.id_oferente</td>
                                <td>@item.identificacion</td>
                                <td>@item.tipo_identificacion</td>
                                <td>@item.nombre_completo</td>
                                <td>@item.fecha_nacimiento.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a asp-page="Editar"
                                       asp-route-id="@item.id_oferente"
                                       class="btn btn-primary btn-sm btn-icon"
                                       title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <a href="/Oferentes/PreparacionAcademica/@item.id_oferente"
                                       class="btn btn-primary btn-sm btn-icon"
                                       title="Preparación académica">
                                        <i class="fas fa-graduation-cap"></i>
                                    </a>

                                    <a href="/Oferentes/ExperienciaLaboral/@item.id_oferente"
                                       class="btn btn-primary btn-sm btn-icon"
                                       title="Experiencia laboral">
                                        <i class="fas fa-briefcase"></i>
                                    </a>

                                    <button type="button"
                                            class="btn btn-danger btn-sm btn-icon"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar"
                                            data-id="@item.id_oferente"
>
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                No se encontraron registros.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        @if (Model.Lista.TotalPaginas > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int numeroPagina = 1; numeroPagina <= Model.Lista.TotalPaginas; numeroPagina++)
                    {
                        <li class="page-item @(numeroPagina == Model.Lista.Pagina ? "active" : "")">
                            <a class="page-link"
                               asp-page="Index"
                               asp-route-pagina="@numeroPagina">
                                @numeroPagina
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

    </div>

</div>

<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Realmente desea eliminar el oferente seleccionado?
                <br />
                <strong id="nombreOferenteEliminar"></strong>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <form id="formEliminar" method="post">
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEliminar = document.getElementById('modalEliminar');

        modalEliminar.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-id');
            const nombre = button.getAttribute('data-nombre');

            document.getElementById('nombreOferenteEliminar').textContent = nombre;
            document.getElementById('formEliminar').action = '/Oferentes?handler=Eliminar&id=' + id;
        });
    </script>
}
