@page "/Oferentes/ExperienciaLaboral/{idOferente:int}/Crear"
@model SitiosPersonal.Pages.Oferentes.ExperienciaLaboral.CrearModel

@{
    ViewData["Title"] = "Agregar Experiencia Laboral";
}

<form method="post">

    <div class="form-action-panel">
        <a asp-page="Index"
               asp-route-idOferente="@Model.Experiencia.id_oferente"
               class="action-circle" title="Regresar">
            <i class="fas fa-arrow-left"></i>
        </a>

        <button type="submit" class="action-circle" title="Guardar">
            <i class="fas fa-save"></i>
        </button>
    </div>

    <div class="form-card card">
        <div class="crud-card-header">
            <h4 class="crud-card-title">Agregar Experiencia Laboral</h4>
            <small class="text-white-50">@Model.Experiencia.NombreOferente</small>
        </div>

        <div class="card-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <input type="hidden" asp-for="Experiencia.id_oferente" />
            <input type="hidden" asp-for="Experiencia.NombreOferente" />

            <div class="row">

                <div class="col-md-12 mb-3">
                    <label class="form-label">Nombre de la empresa <span class="text-danger">*</span></label>
                    <input asp-for="Experiencia.empresa" class="form-control" maxlength="100" />
                    <span asp-validation-for="Experiencia.empresa" class="text-danger"></span>
                </div>

                <div class="col-md-12 mb-3">
                    <label class="form-label">Puesto desempeñado <span class="text-danger">*</span></label>
                    <input asp-for="Experiencia.puesto" class="form-control" maxlength="100" />
                    <span asp-validation-for="Experiencia.puesto" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Fecha de inicio <span class="text-danger">*</span></label>
                    <input asp-for="Experiencia.fecha_inicio" type="date" class="form-control" />
                    <span asp-validation-for="Experiencia.fecha_inicio" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Fecha de fin <span class="text-danger">*</span></label>
                    <input asp-for="Experiencia.fecha_fin" type="date" class="form-control" />
                    <span asp-validation-for="Experiencia.fecha_fin" class="text-danger"></span>
                </div>

            </div>

        </div>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
