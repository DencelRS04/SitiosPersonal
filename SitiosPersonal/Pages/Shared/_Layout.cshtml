@using SitiosPersonal.Services.Services
@inject MenuService MenuService
@inject ParametroService ParametroService

@{
    var nombreUsuario = Context.Session.GetString("NombreCompleto");
    var usuario = Context.Session.GetString("Usuario");
    var idUsuario = Context.Session.GetInt32("IdUsuario");
    var menu = idUsuario == null
        ? new List<SitiosPersonal.Entities.Models.Pantalla>()
        : MenuService.ObtenerMenuPorUsuario(idUsuario.Value);

    // SEG7: leer minutos de inactividad desde parámetro de BD
    int sesionMinutos = 5;
    var paramSesion = ParametroService.ObtenerPorCodigo("SESION_MINUTOS");
    if (paramSesion != null && int.TryParse(paramSesion.valor, out int minParam) && minParam > 0)
        sesionMinutos = minParam;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Personal Sitios</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/personal-sitios.css"
          asp-append-version="true" />
</head>

<body>

    @if (!string.IsNullOrEmpty(nombreUsuario))
    {
        <div class="container-fluid">
            <div class="row">

                <aside class="col-md-3 col-lg-2 sidebar p-3">

                    <div class="text-white mb-4">
                        <h4 class="sidebar-title mb-0">
                            <img src="~/img/logo-personal-salud.png"
                                 alt="Logo Servicios Médicos"
                                 class="sidebar-logo-layout" />
                            Personal Sitios
                        </h4>

                        <small class="sidebar-subtitle">
                            Administración de Personal
                        </small>
                    </div>

                    <ul class="nav flex-column">
                        @foreach (var item in menu)
                        {
                            <li class="nav-item">
                                <a class="nav-link" href="@item.ruta">
                                    <i class="fas @item.icono"></i>
                                    @item.nombre
                                </a>
                            </li>
                        }
                    </ul>

                </aside>

                <main class="col-md-9 col-lg-10 p-0">

                    <nav class="topbar d-flex justify-content-between align-items-center px-4">

                        <div class="page-title">
                            @ViewData["Title"]
                        </div>

                        <div class="d-flex align-items-center gap-3">

                            <div class="text-end">
                                <div class="fw-bold">
                                    @nombreUsuario
                                </div>

                                <small class="text-muted">
                                    @usuario
                                </small>
                            </div>

                            <div class="avatar">
                                @nombreUsuario.Substring(0, 1).ToUpper()
                            </div>

                            <a href="/Logout"
                                   class="btn btn-outline-danger btn-sm">
                                <i class="fas fa-sign-out-alt"></i>
                                Salir
                            </a>
                        </div>

                    </nav>

                    <div class="content-wrapper">
                        @RenderBody()
                    </div>

                </main>

            </div>
        </div>
    }
    else
    {
        <main>
            @RenderBody()
        </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    @if (!string.IsNullOrEmpty(nombreUsuario))
    {
        <!-- Modal SEG7: Sesión Expirada -->
        <div class="modal fade" id="modalSesionExpirada" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Sesión Expirada</h5>
                    </div>
                    <div class="modal-body">
                        La sesión ha expirado por inactividad. Por favor inicie sesión nuevamente.
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="btnAceptarSesion">
                            Aceptar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal de errores de validación -->
        <div class="modal fade" id="modalValidacion" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">Errores</h5>
                    </div>
                    <div class="modal-body">
                        <ul id="listaErroresValidacion" class="mb-0"></ul>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <script>
                (function () {
                    var TIEMPO_INACTIVIDAD = @sesionMinutos * 60 * 1000;
                    var timerInactividad;
                    var modalMostrado = false;

                    function reiniciarTimer() {
                        if (modalMostrado) return;

                        clearTimeout(timerInactividad);
                        timerInactividad = setTimeout(mostrarModalExpiracion, TIEMPO_INACTIVIDAD);
                    }

                    function mostrarModalExpiracion() {
                        if (modalMostrado) return;

                        modalMostrado = true;

                        var modalElement = document.getElementById('modalSesionExpirada');

                        if (!modalElement) {
                            return;
                        }

                        var modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                        modal.show();
                    }

                    var botonAceptar = document.getElementById('btnAceptarSesion');

                    if (botonAceptar) {
                        botonAceptar.addEventListener('click', function () {
                            window.location.href = '/Login';
                        });
                    }

                    ['mousemove', 'keydown', 'click', 'scroll', 'touchstart'].forEach(function (evento) {
                        document.addEventListener(evento, reiniciarTimer, true);
                    });

                    reiniciarTimer();
                })();
        </script>
    }

    <script>
            window.mostrarModalValidacion = function (mensajes) {
                if (!Array.isArray(mensajes)) {
                    mensajes = [mensajes];
                }

                var lista = document.getElementById('listaErroresValidacion');
                var modalElement = document.getElementById('modalValidacion');

                if (!lista || !modalElement) {
                    return;
                }

                var mensajesUnicos = [];

                mensajes.forEach(function (mensaje) {
                    mensaje = (mensaje || '').trim();

                    if (mensaje && mensajesUnicos.indexOf(mensaje) === -1) {
                        mensajesUnicos.push(mensaje);
                    }
                });

                if (mensajesUnicos.length === 0) {
                    return;
                }

                lista.innerHTML = '';

                mensajesUnicos.forEach(function (mensaje) {
                    var li = document.createElement('li');
                    li.textContent = mensaje;
                    lista.appendChild(li);
                });

                var modal = bootstrap.Modal.getOrCreateInstance(modalElement);
                modal.show();
            };
    </script>

    @if (ViewData["ErrorModal"] != null)
    {
        <script>
                document.addEventListener('DOMContentLoaded', function () {
                    var mensaje = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["ErrorModal"]?.ToString()));

                    if (mensaje && typeof window.mostrarModalValidacion === 'function') {
                        window.mostrarModalValidacion([mensaje]);
                    }
                });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>