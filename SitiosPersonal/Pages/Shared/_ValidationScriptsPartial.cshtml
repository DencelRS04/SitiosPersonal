<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

<script>
    $(function () {
        var $form = $('form').first();

        function obtenerMensajesServidor() {
            var mensajes = [];

            document.querySelectorAll('span.field-validation-error').forEach(function (span) {
                var mensaje = (span.textContent || '').trim();

                if (mensaje) {
                    mensajes.push(mensaje);
                }
            });

            document.querySelectorAll('[data-valmsg-summary="true"] li').forEach(function (li) {
                var mensaje = (li.textContent || '').trim();

                if (mensaje) {
                    mensajes.push(mensaje);
                }
            });

            return mensajes;
        }

        function ocultarErroresInline() {
            document.querySelectorAll('[data-valmsg-summary="true"]').forEach(function (elemento) {
                elemento.classList.add('d-none');
            });

            document.querySelectorAll('span.field-validation-error').forEach(function (elemento) {
                elemento.classList.add('d-none');
            });
        }

        function mostrarErrores(mensajes) {
            ocultarErroresInline();

            if (typeof window.mostrarModalValidacion === 'function') {
                window.mostrarModalValidacion(mensajes);
            }
        }

        if ($form.length > 0) {
            var validator = $form.data('validator');

            if (validator) {
                validator.settings.errorPlacement = function () { };
            }

            var formElement = $form[0];

            formElement.addEventListener('submit', function (e) {
                if (typeof $form.valid === 'function' && !$form.valid()) {
                    e.preventDefault();
                    e.stopPropagation();
                    e.stopImmediatePropagation();

                    var validador = $form.data('validator');
                    var errores = validador ? validador.errorList : [];

                    var mensajes = errores.map(function (error) {
                        return error.message;
                    });

                    mostrarErrores(mensajes);
                }
            }, true);
        }

        var erroresServidor = obtenerMensajesServidor();

        if (erroresServidor.length > 0) {
            mostrarErrores(erroresServidor);
        } else {
            ocultarErroresInline();
        }
    });
</script>