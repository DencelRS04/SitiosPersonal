@page
@model SitiosPersonal.Pages.Puestos.IndexModel
@{
    ViewData["Title"] = "Puestos";
}

<div class="crud-card card">
    <div class="crud-card-header d-flex justify-content-between align-items-center">
        <h4 class="crud-card-title"><i class="fas fa-briefcase"></i> Administración de Puestos</h4>
        <a asp-page="Crear" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Nuevo</a>
    </div>
    <div class="card-body">
        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success">@TempData["Exito"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Salario</th>
                        <th>Jefatura</th>
                        <th style="width:210px;" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ViewModel.Puestos.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No se encontraron registros.</td>
                        </tr>
                    }
                    @foreach (var p in Model.ViewModel.Puestos)
                    {
                        <tr>
                            <td><code>@p.codigo</code></td>
                            <td>@p.nombre</td>
                            <td>₡ @p.monto_salario.ToString("N2")</td>
                            <td>@(p.NombreJefatura ?? "<sin jefatura>")</td>
                            <td class="text-center">
                                <a asp-page="Editar" asp-route-id="@p.id_puesto"
                                   class="btn btn-primary btn-sm btn-icon" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a asp-page="RequisitoPuestos/Index" asp-route-id="@p.id_puesto"
                                   class="btn btn-warning btn-sm btn-icon" title="Requisitos">
                                    <i class="fas fa-list-check"></i>
                                </a>
                                <button type="button" class="btn btn-danger btn-sm btn-icon"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEliminar"
                                        data-id="@p.id_puesto"
                                        data-nombre="@p.nombre"
                                        title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.ViewModel.TotalPaginas > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.ViewModel.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.ViewModel.Pagina ? "active" : "")">
                            <a class="page-link" asp-page="Index" asp-route-pagina="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Realmente desea eliminar el elemento seleccionado?<br />
                <strong id="nombrePuestoEliminar"></strong>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <form id="formEliminar" method="post">
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEliminar = document.getElementById('modalEliminar');
        modalEliminar.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-id');
            const nombre = button.getAttribute('data-nombre');
            document.getElementById('nombrePuestoEliminar').textContent = nombre;
            document.getElementById('formEliminar').action = '/Puestos/Index?handler=Eliminar&id=' + id;
        });
    </script>
}
