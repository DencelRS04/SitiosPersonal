@page
@model SitiosPersonal.Pages.Puestos.CrearModel
@{
    ViewData["Title"] = "Formulario Puesto";
}

<form method="post" autocomplete="off">
    <div class="form-action-panel">
        <a asp-page="Index" class="action-circle" title="Regresar">
            <i class="fas fa-arrow-left"></i>
        </a>
        <button type="submit" class="action-circle" title="Guardar">
            <i class="fas fa-save"></i>
        </button>
    </div>

    <div class="form-card card">
        <div class="crud-card-header">
            <h4 class="crud-card-title">Formulario Puesto</h4>
        </div>
        <div class="card-body">

            <div class="mb-3">
                <label asp-for="Input.codigo" class="form-label">Código *</label>
                <input asp-for="Input.codigo" class="form-control" placeholder="Ej. PUE-001" autocomplete="off" />
                <span asp-validation-for="Input.codigo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.nombre" class="form-label">Nombre *</label>
                <input asp-for="Input.nombre" class="form-control" placeholder="Nombre del puesto" autocomplete="off" />
                <span asp-validation-for="Input.nombre" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.monto_salario" class="form-label">Monto Salario *</label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input asp-for="Input.monto_salario" class="form-control" type="number" step="0.01" min="0" />
                </div>
                <span asp-validation-for="Input.monto_salario" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.id_puesto_jefatura" class="form-label">Puesto Jefatura (opcional)</label>
                <select asp-for="Input.id_puesto_jefatura" class="form-select"
                        asp-items="@(new SelectList(Model.PuestosDisponibles, "id_puesto", "nombre"))">
                    <option value="">-- Sin jefatura --</option>
                </select>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
