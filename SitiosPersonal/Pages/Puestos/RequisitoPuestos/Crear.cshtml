@page "{id:int}"
@model SitiosPersonal.Pages.Puestos.RequisitoPuestos.CrearModel
@{
    ViewData["Title"] = "Formulario Requisito";
}

<form method="post" autocomplete="off">
    <div class="form-action-panel">
        <a asp-page="Index" asp-route-id="@Model.Input.id_puesto" class="action-circle" title="Regresar">
            <i class="fas fa-arrow-left"></i>
        </a>
        <button type="submit" class="action-circle" title="Guardar">
            <i class="fas fa-save"></i>
        </button>
    </div>

    <div class="form-card card">
        <div class="crud-card-header">
            <h4 class="crud-card-title">Formulario Requisito — @Model.NombrePuesto</h4>
        </div>
        <div class="card-body">

            <input type="hidden" asp-for="Input.id_puesto" />

            <div class="mb-3">
                <label asp-for="Input.nombre" class="form-label">Nombre del Requisito *</label>
                <input asp-for="Input.nombre" class="form-control"
                       placeholder="Ej. Licenciatura en Administración" autocomplete="off" />
                <span asp-validation-for="Input.nombre" class="text-danger"></span>
            </div>

        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
