@page "{id:int}"
@model SitiosPersonal.Pages.Puestos.RequisitoPuestos.EditarModel
@{
    ViewData["Title"] = "Editar Requisito";
}

<div class="page-header">
    <div>
        <a asp-page="Index" asp-route-id="@Model.Input.id_puesto" class="btn btn-outline-secondary btn-sm me-2">
            <i class="fas fa-arrow-left"></i>
        </a>
        <strong>Editar Requisito — @Model.NombrePuesto</strong>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h5 class="card-title mb-4 text-danger"><i class="fas fa-edit me-2"></i>Formulario Requisito</h5>

        <form method="post">
            <input type="hidden" asp-for="Input.id_requisito" />
            <input type="hidden" asp-for="Input.id_puesto" />
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.nombre" class="form-label fw-semibold">Nombre del Requisito *</label>
                    <input asp-for="Input.nombre" class="form-control" />
                    <span asp-validation-for="Input.nombre" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-1"></i>Guardar
                </button>
                <a asp-page="Index" asp-route-id="@Model.Input.id_puesto" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>Regresar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
