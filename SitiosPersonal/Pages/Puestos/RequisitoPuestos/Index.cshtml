@page "{id:int}"
@model SitiosPersonal.Pages.Puestos.RequisitoPuestos.IndexModel
@{
    ViewData["Title"] = "Requisitos del Puesto";
}

<div class="crud-card card">
    <div class="crud-card-header d-flex justify-content-between align-items-center">
        <h4 class="crud-card-title">
            <i class="fas fa-list-check"></i> Requisitos — @Model.ViewModel.NombrePuesto
        </h4>
        <div class="d-flex gap-2">
            <a asp-page="/Puestos/Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Puestos
            </a>
            <a asp-page="Crear" asp-route-id="@Model.ViewModel.id_puesto" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Nuevo
            </a>
        </div>
    </div>
    <div class="card-body">
        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success">@TempData["Exito"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th style="width:60px;">#</th>
                        <th>Nombre del Requisito</th>
                        <th style="width:140px;" class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ViewModel.Requisitos.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">No se encontraron registros.</td>
                        </tr>
                    }
                    @{ int n = (Model.ViewModel.Pagina - 1) * Model.ViewModel.CantidadPorPagina + 1; }
                    @foreach (var r in Model.ViewModel.Requisitos)
                    {
                        <tr>
                            <td class="text-muted">@(n++)</td>
                            <td>@r.nombre</td>
                            <td class="text-center">
                                <a asp-page="Editar" asp-route-id="@r.id_requisito"
                                   class="btn btn-primary btn-sm btn-icon" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-danger btn-sm btn-icon"
                                        data-bs-toggle="modal"
                                        data-bs-target="#modalEliminar"
                                        data-id="@r.id_requisito"
                                        data-nombre="@r.nombre"
                                        title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.ViewModel.TotalPaginas > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int i = 1; i <= Model.ViewModel.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.ViewModel.Pagina ? "active" : "")">
                            <a class="page-link" asp-page="Index" asp-route-id="@Model.ViewModel.id_puesto" asp-route-pagina="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

<!-- Modal eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Realmente desea eliminar el elemento seleccionado?<br />
                <strong id="nombreRequisitoEliminar"></strong>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <form id="formEliminarRequisito" method="post">
                    <input type="hidden" name="idRequisito" id="hiddenIdRequisito" />
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEliminar = document.getElementById('modalEliminar');
        modalEliminar.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-id');
            const nombre = button.getAttribute('data-nombre');
            document.getElementById('nombreRequisitoEliminar').textContent = nombre;
            document.getElementById('hiddenIdRequisito').value = id;
            document.getElementById('formEliminarRequisito').action =
                '/Puestos/RequisitoPuestos/@Model.ViewModel.id_puesto?handler=Eliminar';
        });
    </script>
}
