@page "{id:int}"
@model SitiosPersonal.Pages.Puestos.RequisitoPuestos.IndexModel
@{
    ViewData["Title"] = "Requisitos del Puesto";
}

<div class="page-header">
    <div>
        <a asp-page="/Puestos/Index" class="btn btn-outline-secondary btn-sm me-2">
            <i class="fas fa-arrow-left"></i>
        </a>
        <strong>Requisitos — @Model.ViewModel.NombrePuesto</strong>
    </div>
    <a asp-page="Crear" asp-route-id="@Model.ViewModel.id_puesto" class="btn btn-primary btn-sm">
        <i class="fas fa-plus me-1"></i>Nuevo
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nombre del Requisito</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.ViewModel.Requisitos.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>No hay requisitos registrados para este puesto.
                            </td>
                        </tr>
                    }
                    @{ int n = (Model.ViewModel.Pagina - 1) * Model.ViewModel.CantidadPorPagina + 1; }
                    @foreach (var r in Model.ViewModel.Requisitos)
                    {
                        <tr>
                            <td class="text-muted">@(n++)</td>
                            <td>@r.nombre</td>
                            <td class="text-center">
                                <a asp-page="Editar" asp-route-id="@r.id_requisito"
                                   class="btn btn-sm btn-outline-warning me-1" title="Editar">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        onclick="confirmarEliminar(@r.id_requisito, '@r.nombre')"
                                        title="Eliminar">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (Model.ViewModel.TotalPaginas > 1)
    {
        <div class="card-footer d-flex align-items-center justify-content-between">
            <small class="text-muted">Página @Model.ViewModel.Pagina de @Model.ViewModel.TotalPaginas (@Model.ViewModel.TotalRegistros registros)</small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    @for (int i = 1; i <= Model.ViewModel.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.ViewModel.Pagina ? "active" : "")">
                            <a class="page-link" asp-page="Index" asp-route-id="@Model.ViewModel.id_puesto" asp-route-pagina="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Modal eliminar -->
<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle text-danger me-2"></i>Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">¿Realmente desea eliminar el elemento seleccionado?<br><strong id="nombreEliminar"></strong></div>
            <div class="modal-footer border-0">
                <form method="post">
                    <input type="hidden" name="id" id="hiddenId" />
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">No</button>
                    <button type="submit" asp-page-handler="Eliminar" class="btn btn-danger">Sí, eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function confirmarEliminar(id, nombre) {
    document.getElementById('nombreEliminar').textContent = nombre;
    document.getElementById('hiddenId').value = id;
    new bootstrap.Modal(document.getElementById('modalEliminar')).show();
}
</script>
}
