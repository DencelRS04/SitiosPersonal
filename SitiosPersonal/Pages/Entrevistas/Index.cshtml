@page "/Oferentes/Entrevistas"
@model SitiosPersonal.Pages.Entrevistas.IndexModel

@{
    ViewData["Title"] = "Agendar Entrevistas";
}

<div class="crud-card card">

    <div class="crud-card-header d-flex justify-content-between align-items-center">
        <h4 class="crud-card-title">
            Agendar Entrevistas
        </h4>

        <a asp-page="Crear" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i>
            Agendar nueva entrevista
        </a>
    </div>

    <div class="card-body">

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success">@TempData["Exito"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead>
                    <tr>
                        <th>Oferente</th>
                        <th>Entrevistador</th>
                        <th style="width:130px;">Fecha entrevista</th>
                        <th style="width:110px;">Estado</th>
                        <th style="width:170px;">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Lista.Entrevistas.Any())
                    {
                        foreach (var item in Model.Lista.Entrevistas)
                        {
                            <tr>
                                <td>@item.NombreOferente</td>
                                <td>[@item.NumeroEmpleado] @item.NombreEmpleado</td>
                                <td>@item.fecha_entrevista.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge @(item.estado == "PENDIENTE" ? "bg-warning text-dark" : "bg-success")">
                                        @item.estado
                                    </span>
                                </td>
                                <td>
                                    <a asp-page="Editar"
                                       asp-route-id="@item.id_entrevista"
                                       class="btn btn-primary btn-sm btn-icon"
                                       title="Cambiar datos">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    @if (item.estado == "PENDIENTE")
                                    {
                                        <form asp-page-handler="MarcarRealizada"
                                              asp-route-id="@item.id_entrevista"
                                              method="post"
                                              class="d-inline">
                                            <button type="submit"
                                                    class="btn btn-success btn-sm btn-icon"
                                                    title="Marcar como completada">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </form>
                                    }

                                    <button type="button"
                                            class="btn btn-danger btn-sm btn-icon"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar"
                                            data-id="@item.id_entrevista"

                                            title="Eliminar">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                No se encontraron registros.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        @if (Model.Lista.TotalPaginas > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int numeroPagina = 1; numeroPagina <= Model.Lista.TotalPaginas; numeroPagina++)
                    {
                        <li class="page-item @(numeroPagina == Model.Lista.Pagina ? "active" : "")">
                            <a class="page-link"
                               asp-page="Index"
                               asp-route-pagina="@numeroPagina">
                                @numeroPagina
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

    </div>

</div>

<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Realmente desea eliminar el elemento seleccionado?
                <br />
                <strong id="nombreEntrevistaEliminar"></strong>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <form id="formEliminar" method="post">
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalEliminar = document.getElementById('modalEliminar');
        modalEliminar.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-id');
            const nombre = button.getAttribute('data-nombre');

            document.getElementById('nombreEntrevistaEliminar').textContent = nombre;
            document.getElementById('formEliminar').action =
                '/Oferentes/Entrevistas?handler=Eliminar&id=' + id;
        });
    </script>
}
