@page
@model SitiosPersonal.Pages.Login.IndexModel

@{
    Layout = null;
    ViewData["Title"] = "Inicio de Sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Inicio de Sesión - Personal Sitios</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/personal-sitios.css"
          asp-append-version="true" />
</head>

<body class="login-body">

    <div class="container min-vh-100 d-flex align-items-center justify-content-center">

        <div class="card shadow-sm login-card">

            <div class="crud-card-header text-center">

                <div class="mb-3">
                    <img src="~/img/logo-personal-salud.png"
                         alt="Logo Servicios Médicos"
                         class="login-logo"
                         asp-append-version="true" />
                </div>

                <h4 class="crud-card-title">
                    Personal Sitios
                </h4>

                <small class="text-muted">
                    Administración de Personal
                </small>

            </div>

            <div class="card-body">

                @if (!string.IsNullOrEmpty(Model.Mensaje))
                {
                    bool esExpiracion =
                        Model.Mensaje.Contains("expirado") ||
                        Model.Mensaje.Contains("expirada") ||
                        (Model.Mensaje.Contains("inicie ses") && !Model.Mensaje.Contains("cerrada"));

                    <div class="alert @(esExpiracion ? "alert-warning" : "alert-success")">
                        @if (esExpiracion)
                        {
                            <i class="fas fa-clock me-1"></i>
                        }
                        else
                        {
                            <i class="fas fa-check-circle me-1"></i>
                        }

                        @Model.Mensaje
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Error))
                {
                    <div class="alert alert-danger">
                        @Model.Error
                    </div>
                }

                <form method="post">

                    <div class="mb-3">
                        <label class="form-label">
                            Usuario
                        </label>

                        <input asp-for="Login.Usuario"
                               class="form-control" />

                        <span asp-validation-for="Login.Usuario"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Contraseña
                        </label>

                        <input asp-for="Login.Password"
                               type="password"
                               class="form-control" />

                        <span asp-validation-for="Login.Password"
                              class="text-danger"></span>
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Aceptar
                    </button>

                </form>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>