@page "/Concursos"
@model SitiosPersonal.Pages.Concursos.IndexModel

@{
    ViewData["Title"] = "Concursos";
}

<div class="crud-card card">

    <div class="crud-card-header d-flex justify-content-between align-items-center">

        <h4 class="crud-card-title">
            <i class=></i>
            Mantenimiento de Concursos
        </h4>

        <a asp-page="Crear" class="btn btn-primary btn-sm">
            <i class="fas fa-plus"></i>
            Nuevo
        </a>

    </div>

    <div class="card-body">

        @if (TempData["Exito"] != null)
        {
            <div class="alert alert-success">
                @TempData["Exito"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead>
                    <tr>
                        <th style="width:80px;">ID</th>
                        <th style="width:130px;">Código</th>
                        <th>Nombre</th>
                        <th style="width:130px;">Fecha inicio</th>
                        <th style="width:130px;">Fecha fin</th>
                        <th style="width:110px;">Estado</th>
                        <th style="width:170px;">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Lista.Concursos.Any())
                    {
                        foreach (var item in Model.Lista.Concursos)
                        {
                            <tr>
                                <td>@item.id_concurso</td>
                                <td>@item.codigo</td>
                                <td>@item.nombre</td>
                                <td>@item.fecha_inicio.ToString("dd/MM/yyyy")</td>
                                <td>@item.fecha_fin.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge @(item.estado == "VIGENTE" ? "bg-success" : "bg-secondary")">
                                        @item.estado
                                    </span>
                                </td>
                                <td>
                                    <a asp-page="Editar"
                                       asp-route-id="@item.id_concurso"
                                       class="btn btn-primary btn-sm btn-icon"
                                       title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <form asp-page-handler="CambiarEstado"
                                          asp-route-id="@item.id_concurso"
                                          method="post"
                                          class="d-inline">
                                        <button type="submit"
                                                class="btn btn-warning btn-sm btn-icon"
                                                title="Vigente/Vencido"
                                                >
                                            <i class="fas fa-power-off"></i>
                                        </button>
                                    </form>

                                    <button type="button"
                                            class="btn btn-danger btn-sm btn-icon"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEliminar"
                                            data-id="@item.id_concurso"

                                            title="Eliminar">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">
                                No se encontraron registros.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        @if (Model.Lista.TotalPaginas > 1)
        {
            <nav>
                <ul class="pagination justify-content-center">
                    @for (int numeroPagina = 1; numeroPagina <= Model.Lista.TotalPaginas; numeroPagina++)
                    {
                        <li class="page-item @(numeroPagina == Model.Lista.Pagina ? "active" : "")">
                            <a class="page-link"
                               asp-page="Index"
                               asp-route-pagina="@numeroPagina">
                                @numeroPagina
                            </a>
                        </li>
                    }
                </ul>
            </nav>
        }

    </div>

</div>


<div class="modal fade" id="modalEliminar" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Realmente desea eliminar el concurso seleccionado?
                <br />
                <strong id="nombreConcursoEliminar"></strong>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <form id="formEliminar" method="post">
                    <button type="submit" class="btn btn-danger">Sí</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            new bootstrap.Tooltip(el);
        });

        const modalEliminar = document.getElementById('modalEliminar');
        modalEliminar.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            const id = button.getAttribute('data-id');
            const nombre = button.getAttribute('data-nombre');

            document.getElementById('nombreConcursoEliminar').textContent = nombre;
            document.getElementById('formEliminar').action =
                '/Concursos?handler=Eliminar&id=' + id;
        });
    </script>
}
